# 应用配置
DEBUG=false
APP_NAME="KX Exam System Backend"

# 数据库配置
DATABASE_URL="sqlite+aiosqlite:///./exam_system.db"

# JWT 配置
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 超级管理员配置
SUPER_ADMIN_KEY="super-admin-secret-key"

# CORS 配置
CORS_ORIGINS=["*"]
